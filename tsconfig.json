{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2015",
    "lib": ["es2022", "dom"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "types",
    "noImplicitAny": false,
    "allowJs": false,
    "skipLibCheck": true
  },
  "include": [
    "src/*.ts"
  ]
}
